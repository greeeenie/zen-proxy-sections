[
  {
    "property": "extensions.zen-proxy-divider.style",
    "label": "Sidebar style",
    "type": "dropdown",
    "defaultValue": "divider",
    "options": [
      {
        "label": "Capsule divider",
        "value": "divider"
      },
      {
        "label": "Section headers",
        "value": "sections"
      }
    ],
    "placeholder": false
  },
  {
    "property": "extensions.zen-proxy-divider.divider-order",
    "label": "Section order",
    "type": "dropdown",
    "defaultValue": "proxy-direct",
    "options": [
      {
        "label": "PROXY ↑ · DIRECT ↓",
        "value": "proxy-direct"
      },
      {
        "label": "DIRECT ↑ · PROXY ↓",
        "value": "direct-proxy"
      }
    ],
    "placeholder": false,
    "conditions": {
      "if": {
        "property": "extensions.zen-proxy-divider.style",
        "value": "divider"
      }
    }
  },
  {
    "property": "extensions.zen-proxy-divider.sections-order",
    "label": "Section order",
    "type": "dropdown",
    "defaultValue": "proxy-direct",
    "options": [
      {
        "label": "PROXY, then DIRECT",
        "value": "proxy-direct"
      },
      {
        "label": "DIRECT, then PROXY",
        "value": "direct-proxy"
      }
    ],
    "placeholder": false,
    "conditions": {
      "if": {
        "property": "extensions.zen-proxy-divider.style",
        "value": "sections"
      }
    }
  },
  {
